# Unique output paths keep repeated runs independent without deleting user files.
string(RANDOM LENGTH 12 nonce)
set(root "${WORK}/${nonce}")
file(MAKE_DIRECTORY "${root}/empty" "${root}/corrupt")
function(expect expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code
    OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected ${expected}, got ${code}: ${stdout} ${stderr}")
  endif()
endfunction()
expect(2)
expect(2 "${root}/missing" "${root}/missing.csv")
expect(2 "${root}/empty" "${root}/empty.csv")
file(READ "${root}/empty.csv" header)
if(NOT header MATCHES "^index,path,status,")
  message(FATAL_ERROR "Empty input must emit a CSV header")
endif()
file(WRITE "${root}/corrupt/01.jpg" "not an image")
file(WRITE "${root}/corrupt/02.PNG" "")
expect(1 "${root}/corrupt" "${root}/errors.csv")
file(READ "${root}/errors.csv" report)
string(REGEX MATCHALL ",error,,,,," errors "${report}")
list(LENGTH errors count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Expected a CSV row for both corrupt files")
endif()
expect(2 "${root}/corrupt" "${root}/errors.csv")
file(READ "${root}/errors.csv" preserved)
if(NOT report STREQUAL preserved)
  message(FATAL_ERROR "Existing CSV was modified")
endif()
expect(2 "${root}/corrupt" "${root}/corrupt/01.jpg")
expect(2 "${root}/corrupt" "${root}/no-parent/out.csv")
expect(1 "${root}/corrupt" "${root}/with-details.csv" "${root}/stars.csv")
file(READ "${root}/stars.csv" stars)
if(NOT stars MATCHES "candidate_id,x,y,major_sigma")
  message(FATAL_ERROR "Missing candidate CSV header")
endif()
expect(2 "${root}/empty" "${root}/same.csv" "${root}/same.csv")
expect(2 "${root}/empty" "${root}/new.csv" "${root}/stars.csv")
expect(2 "${root}/empty" "${root}/bad-limit.csv" "--peak-limit" "-1")
expect(2 "${root}/empty" "${root}/bad-limit2.csv" "--peak-limit" "abc")
expect(1 "${root}/corrupt" "${root}/capped.csv" "--peak-limit" "2000")
